# SignalPipe daemon configuration. Copy to `.env` and fill in.
# A real environment variable always wins over a value in this file.

# --- Required ---------------------------------------------------------------
# Your SignalPipe operator key (from the dashboard).
SIGNALPIPE_KEY=

# The brain URL. Leave unset to use the default production endpoint.
# SIGNALPIPE_API_URL=https://api.signalpipe.io

# --- Reddit (enables reddit_comment + reddit_dm) ----------------------------
# Create a "script" app at https://www.reddit.com/prefs/apps on the SENDING
# account. These creds stay on this machine and are NEVER sent to SignalPipe.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# REDDIT_USER_AGENT=signalpipe-daemon/1.0

# --- X / Twitter (enables twitter_reply) ------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Daily send caps (anti-spam pacing; reset at local midnight) ------------
# MAX_TWITTER_ACTIONS_PER_DAY=10
# MAX_REDDIT_DMS_PER_DAY=5
# MAX_REDDIT_COMMENTS_PER_DAY=15
